# =============================================================================
# direnv Configuration
# =============================================================================
# Automatically configures your shell environment when entering this directory.
#
# Setup (one-time):
#   1. Install direnv: brew install direnv (macOS) or apt install direnv (Linux)
#   2. Add hook to shell (add to ~/.bashrc, ~/.zshrc, etc.):
#      eval "$(direnv hook bash)"   # for bash
#      eval "$(direnv hook zsh)"    # for zsh
#   3. Allow this directory: direnv allow
#
# What this does:
#   - Adds ./bin to PATH (for project scripts)
#   - Loads .env file if present (environment variables)
#
# To add more environment setup:
#   - Add export statements below
#   - Run `direnv allow` after changes
#
# Documentation: https://direnv.net/
# =============================================================================

# Add project bin directory to PATH
# This allows running ./bin/bootstrap as just `bootstrap`
PATH_add bin

# Load .env file if it exists (for local development secrets)
# Note: .env is gitignored and should never be committed
dotenv_if_exists
